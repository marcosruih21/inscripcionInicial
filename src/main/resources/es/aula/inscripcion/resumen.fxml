<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="es.aula.inscripcion.ResumenController"
      alignment="CENTER"
      spacing="20"
      prefWidth="760.0"
      prefHeight="580.0"
      styleClass="pantalla"
      stylesheets="@estilos.css">

    <padding>
        <Insets top="35" right="50" bottom="35" left="50"/>
    </padding>

    <Label text="Resumen de inscripción"
           styleClass="titulo-pantalla"/>

    <Label text="Revisa los datos que has introducido."
           styleClass="texto-descripcion"/>

    <VBox spacing="16"
          maxWidth="520"
          styleClass="tarjeta">

        <Label text="Datos del participante"
               styleClass="titulo-seccion"/>

        <Label text="Participante:"
               styleClass="etiqueta"/>

        <Label fx:id="nombreResumenLabel"
               text="No indicado"
               styleClass="valor-resumen"
               wrapText="true"/>

        <Label text="Modalidad:"
               styleClass="etiqueta"/>

        <Label fx:id="modalidadResumenLabel"
               text="No seleccionada"
               styleClass="valor-resumen"
               wrapText="true"/>

        <Label text="Fecha del torneo:"
               styleClass="etiqueta"/>

        <Label fx:id="fechaResumenLabel"
               text="No seleccionada"
               styleClass="valor-resumen"/>

        <Label text="¿Necesita material?"
               styleClass="etiqueta"/>

        <Label fx:id="materialResumenLabel"
               text="No"
               styleClass="valor-resumen"/>

        <Label text="Observaciones:"
               styleClass="etiqueta"/>

        <Label fx:id="observacionesResumenLabel"
               text="Sin observaciones"
               styleClass="valor-resumen"
               wrapText="true"/>
    </VBox>

    <HBox alignment="CENTER" spacing="12">
        <Button fx:id="volverFormularioButton"
        text="Volver al formulario"
        onAction="#volverFormulario"
        styleClass="boton-secundario"
        prefHeight="42"/>

        <Button fx:id="inicioButton"
        text="Inicio"
        onAction="#volverInicio"
        styleClass="boton-principal"
        prefHeight="42"/>
    </HBox>

    <Label text="Este resumen es una simulación. Los datos no se han enviado."
           styleClass="texto-secundario"
           wrapText="true"/>

</VBox>
